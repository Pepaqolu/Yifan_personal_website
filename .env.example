# Public Supabase project settings. The publishable key is safe for browser use;
# database access is still enforced by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Trusted public origin used for password-reset and invite redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Never prefix this with NEXT_PUBLIC_ and never expose it to client code.
# Required only for admin invitations and the setup scripts.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Server-only AI provider settings. Use AI_PROVIDER=fixture for deterministic
# local development without external calls. Production defaults to OpenAI.
AI_PROVIDER=fixture
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-5-mini

# Server-only web search. The app keeps manual URL ingestion available when
# these are absent. Currently supported provider: brave.
SEARCH_PROVIDER=brave
BRAVE_SEARCH_API_KEY=YOUR_BRAVE_SEARCH_API_KEY

# Used by scripts/seed-users.mjs for local development only.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-before-use
SEED_CLIENT_EMAIL=client@example.com
SEED_CLIENT_PASSWORD=change-me-before-use
