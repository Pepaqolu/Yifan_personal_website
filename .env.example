# Public Supabase project settings. The publishable key is safe for browser use;
# database access is still enforced by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Trusted public origin used for password-reset and invite redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Never prefix this with NEXT_PUBLIC_ and never expose it to client code.
# Required only for admin invitations and the setup scripts.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# Server-only AI provider settings. Use AI_PROVIDER=fixture for deterministic
# local development without external calls. Production defaults to OpenAI.
AI_PROVIDER=fixture
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-5-mini

# Server-only web search. The app keeps manual URL ingestion available when
# these are absent. Currently supported provider: brave.
SEARCH_PROVIDER=brave
BRAVE_SEARCH_API_KEY=YOUR_BRAVE_SEARCH_API_KEY

# Required before tokenized research can run. Keep this server-only and update it
# when provider pricing changes; Meridian fails closed when cost is unknown.
BRAVE_SEARCH_COST_PER_REQUEST_USD=YOUR_CURRENT_PER_REQUEST_COST
BRAVE_SEARCH_PRICING_VERSION=YYYY-MM-DD
BRAVE_SEARCH_PRICING_SOURCE=YOUR_PRICING_SOURCE_URL

# Paddle Billing. Begin with sandbox and keep payments disabled until Migration
# 009, the catalog, webhook destination and credentials are all verified.
MERIDIAN_PAYMENTS_ENABLED=false
PADDLE_ENV=sandbox
PADDLE_API_KEY=YOUR_SERVER_API_KEY
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=YOUR_CLIENT_SIDE_TOKEN
PADDLE_WEBHOOK_SECRET=YOUR_NOTIFICATION_DESTINATION_SECRET
PADDLE_PAYG_PRICE_ID=pri_ZERO_DOLLAR_RECURRING
PADDLE_TOKEN_PRICE_5_ID=pri_5_USD
PADDLE_TOKEN_PRICE_20_ID=pri_20_USD
PADDLE_TOKEN_PRICE_50_ID=pri_50_USD
PADDLE_TOKEN_PRICE_100_ID=pri_100_USD
PADDLE_TOKEN_PRICE_250_ID=pri_250_USD
PADDLE_TOKEN_PRICE_500_ID=pri_500_USD

# Used by scripts/seed-users.mjs for local development only.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-before-use
SEED_CLIENT_EMAIL=client@example.com
SEED_CLIENT_PASSWORD=change-me-before-use
